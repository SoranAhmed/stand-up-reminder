<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.StandUpReminder" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.StandUpReminder.FullScreen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/alert_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
